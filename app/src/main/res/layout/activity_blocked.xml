<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="Shield"
        android:src="@drawable/ic_stat"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:text="App blocked"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/blocked_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:text="This app"
        android:textColor="#CCFFFFFF"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:text="This app can only be opened from My App Blocker."
        android:textColor="#99FFFFFF"
        android:textSize="13sp"/>

    <Button
        android:id="@+id/btn_open_here"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Open from App Blocker"/>

    <Button
        android:id="@+id/btn_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="?android:attr/buttonBarButtonStyle"
        android:text="Go home"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="24dp"
        android:text="To allow this app normally, unblock it in My App Blocker."
        android:textColor="#66FFFFFF"
        android:textSize="11sp"/>
</LinearLayout>
