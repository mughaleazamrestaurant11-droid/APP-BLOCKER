<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Needed on Android 8-9 (pre-BiometricPrompt); harmless safety net on newer versions. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:label="Apps &amp; blocking"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".TikTokDownloaderActivity"
            android:exported="false"
            android:label="TikTok downloader"/>

        <activity
            android:name=".BlockedActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Blocked"
            android:theme="@style/BlockedTheme"/>

        <service
            android:name=".BlockerTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="App Blocker"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".LaunchGuardService"
            android:exported="false"
            android:label="App Blocker Launch Guard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/launch_guard_config"/>
        </service>

        <receiver
            android:name=".NewAppReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <data android:scheme="package"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ToggleWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.classic.myappblocker.WIDGET_TOGGLE"/>
                <action android:name="com.classic.myappblocker.WIDGET_REFRESH"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/toggle_widget_info"/>
        </receiver>
    </application>
</manifest>
